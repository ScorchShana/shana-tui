{
  "name": "shana-tui",
  "version": "0.1.0",
  "description": "Terminal UI library with differential rendering, derived from pi-tui",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "tsc -p tsconfig.build.json",
    "build:native:darwin": "native/darwin/build.sh",
    "build:native:linux": "native/linux/build.sh",
    "build:native:win32": "node native/win32/build.mjs",
    "test": "node --test --test-reporter=dot --test-reporter-destination=stdout test/*.test.ts",
    "prepublishOnly": "npm run clean && npm run build",
    "check": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run clean && npm run build"
  },
  "files": [
    "dist/**/*",
    "native/napi.h",
    "native/clipboard.h",
    "native/win32/prebuilds/**/*.node",
    "native/win32/src/**/*.c",
    "native/win32/build.mjs",
    "native/win32/README.md",
    "native/darwin/prebuilds/**/*.node",
    "native/darwin/src/**/*.m",
    "native/darwin/build.sh",
    "native/darwin/README.md",
    "native/linux/prebuilds/**/*.node",
    "native/linux/src/**/*.{c,h}",
    "native/linux/build.sh",
    "native/linux/README.md",
    "README.md",
    "LICENSE",
    "UPSTREAM.md"
  ],
  "keywords": [
    "tui",
    "terminal",
    "ui",
    "text-editor",
    "differential-rendering",
    "typescript",
    "cli"
  ],
  "author": "Mario Zechner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScorchShana/shana-tui.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "types": "./dist/index.d.ts",
  "dependencies": {
    "get-east-asian-width": "1.6.0",
    "marked": "18.0.11",
    "marked-cjk-friendly": "0.1.2"
  },
  "devDependencies": {
    "@xterm/headless": "5.5.0",
    "chalk": "6.0.0",
    "typescript": "5.9.3",
    "@types/node": "24.10.1"
  }
}
